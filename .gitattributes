# Normalise to LF in the repository. Development happens on Windows but
# everything this project produces runs on Linux nodes, and a CRLF shebang
# line is an unhelpful way to discover that.
* text=auto eol=lf

# Files that must be LF regardless of local settings, because they are
# executed on the node or interpreted by cloud-init.
*.sh      text eol=lf
*.bash    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.tmpl    text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf

# Go tooling writes LF and gofmt enforces it.
*.go   text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Binary files git should not try to normalise.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.gz   binary
*.zip  binary
*.exe  binary

# Certificates and keys are text but must never be altered.
*.pem text eol=lf
*.crt text eol=lf
*.key text eol=lf

# Collapse generated and vendored paths in diffs and language stats.
/docs/**      linguist-documentation
*_test.go     linguist-language=Go
