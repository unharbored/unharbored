# Managed by scripts/mgmt/setup.sh. Runs operations: deploys, installs,
# upgrades. --timeout outlasts the longest operation's job timeout.
[Unit]
Description=cloud-manager control plane queue worker
After=network-online.target

[Service]
User=www-data
Environment=HOME=/tmp
WorkingDirectory=/srv/cloud-manager/control-plane
ExecStart=/usr/bin/php artisan queue:work --timeout=1300 --tries=1 --sleep=2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
