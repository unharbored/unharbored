# Secrets and credentials
# This platform handles DigitalOcean OAuth tokens, agent certificates, and
# customer environment variables. Nothing resembling a credential belongs in git.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
known_hosts
auth.json
secrets/
credentials/

# PHP / Laravel control plane
/vendor/
/storage/*.key
/storage/pail/
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
!**/.gitkeep
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.phpactor.json
Homestead.json
Homestead.yaml

# Node / frontend build
node_modules/
/public/build/
/public/hot/
/public/storage
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
*.tsbuildinfo

# Go agent
/agent/bin/
/agent/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# Build and release artifacts
/dist/
/build/
*.tar.gz
*.zip

# Infrastructure state
# Not currently used, but guard against it being added casually later.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# Local databases and dumps
*.sqlite
*.sqlite-journal
*.sql
*.dump

# Editors and tooling
.idea/
.vscode/
.fleet/
*.swp
*.swo
*~
.nova/
.zed/

# Claude Code local settings (keep shared settings.json if one is added)
.claude/settings.local.json

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs and temp
*.log
/tmp/
/scratch/

# Agent builds served to nodes. Rebuilt by scripts/build-agent.sh; the
# control plane hashes whatever is here, so a stale committed binary would
# be worse than none.
/control-plane/storage/agent/*
!/control-plane/storage/agent/.gitkeep

# Per-machine settings for scripts/mgmt (the management server address)
scripts/mgmt/local.env
scripts/live/local.env

# An install's own code, loaded by CustomServiceProvider (see docs/self-hosting.md, "Customising")
/control-plane/custom/
